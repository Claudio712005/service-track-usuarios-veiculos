{
  "uid": "usu-pilha",
  "title": "Plataforma — saúde da própria pilha",
  "description": "Quem observa o observador: alvos de coleta, Prometheus, Loki, Alloy e Grafana.",
  "tags": [
    "service-track",
    "usuarios-veiculos",
    "infra"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Reinícios do serviço",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "resets(process_uptime_seconds{job=\"usuarios-veiculos\"}[$__rate_interval]) > 0",
        "titleFormat": "reinício",
        "step": "60s"
      }
    ]
  },
