{
  "uid": "usu-requisicoes",
  "title": "Usuários e veículos — requisições",
  "description": "Rota a rota: volume, latência, alvos de tempo de resposta, erros e acesso ao repositório.",
  "tags": [
    "service-track",
    "usuarios-veiculos",
    "noc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "rota",
        "label": "Rota",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_seconds_count{job=\"usuarios-veiculos\"}, uri)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "metodo",
        "label": "Método",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_seconds_count{job=\"usuarios-veiculos\"}, method)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Reinícios do serviço",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "expr": "resets(process_uptime_seconds{job=\"usuarios-veiculos\"}[$__rate_interval]) > 0",
        "titleFormat": "reinício",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Volume e latência por rota",
