        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"st_usu\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"st_usu\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=\"st_usu\"}[$__rate_interval])), 0.0001)",
